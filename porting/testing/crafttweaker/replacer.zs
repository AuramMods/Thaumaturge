#priority -1

import crafttweaker.api.ingredient.IIngredient;
import crafttweaker.api.recipe.replacement.Replacer;
import crafttweaker.api.recipe.replacement.type.ManagerFilteringRule;
import crafttweaker.api.recipe.replacement.type.NameFilteringRule;

val arcane = <recipetype:thaumaturge:arcane_workbench>;
arcane.addJson("test_json_copy", arcane.definition(<resource:crafttweaker:test_shaped>));
println("TT_REPLACER_JSON_COPY=" + arcane.definition(<resource:crafttweaker:test_json_copy>));

Replacer.create()
    .filter(ManagerFilteringRule.of(arcane))
    .filter(NameFilteringRule.regex("^crafttweaker:test_shaped$"))
    .replace<IIngredient>(<recipecomponent:crafttweaker:input/ingredients>,
        <item:minecraft:iron_ingot> as IIngredient,
        <item:minecraft:copper_ingot> as IIngredient)
    .execute();

println("TT_REPLACER_SHAPED=" + arcane.definition(<resource:crafttweaker:autogenerated/replacer/crafttweaker.test_shaped.1>));
